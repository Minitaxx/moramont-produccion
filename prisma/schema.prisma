generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MODELOS DEL SISTEMA PRINCIPAL (referencia, no modificar)
// ============================================================

model ProductCatalog {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  productType    String
  geometryType   String   @default("rectangular")
  fixedPrice     Decimal? @db.Decimal(10, 4)
  canBeAccessory Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  manufacturingProcesses ManufacturingProcess[] @relation("ProductManufacturingProcesses")
  workOrders             WorkOrder[]

  @@map("product_catalog")
}

model Material {
  id   String @id @default(cuid())
  name String @unique

  processMaterials ProcessMaterial[]

  @@map("materials")
}

// ============================================================
// MODELOS NUEVOS DEL MÓDULO DE PRODUCCIÓN
// ============================================================

model ProcessType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  processes      ManufacturingProcess[]
  workOrderTasks WorkOrderTask[]

  @@map("process_types")
}

model Machine {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  processes ManufacturingProcess[]

  @@map("machines")
}

model ManufacturingProcess {
  id               String         @id @default(cuid())
  catalogProductId String
  catalogProduct   ProductCatalog @relation("ProductManufacturingProcesses", fields: [catalogProductId], references: [id], onDelete: Cascade)
  processTypeId    String
  processType      ProcessType    @relation(fields: [processTypeId], references: [id])
  order            Int
  machineId        String?
  machine          Machine?       @relation(fields: [machineId], references: [id])
  estimatedMinutes Decimal?       @db.Decimal(10, 2)
  notes            String?

  materials ProcessMaterial[]

  @@unique([catalogProductId, order])
  @@map("manufacturing_processes")
}

model ProcessMaterial {
  id         String               @id @default(cuid())
  processId  String
  process    ManufacturingProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  materialId String
  material   Material             @relation(fields: [materialId], references: [id])
  quantity   Decimal              @db.Decimal(10, 4)
  unit       String

  @@map("process_materials")
}

// ============================================================
// MÓDULO: CONTROL DE TIEMPOS POR OPERARIO
// ============================================================

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  BLOCKED
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum RecordStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

model Operator {
  id           String   @id @default(cuid())
  name         String
  employeeCode String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  assignedTasks WorkOrderTaskOperator[]
  timeRecords   TaskTimeRecord[]

  @@map("operators")
}

model WorkOrder {
  id            String          @id @default(cuid())
  code          String          @unique
  productId     String
  product       ProductCatalog  @relation(fields: [productId], references: [id])
  quantityTotal Int
  status        WorkOrderStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tasks WorkOrderTask[]

  @@map("work_orders")
}

model WorkOrderTask {
  id            String      @id @default(cuid())
  workOrderId   String
  workOrder     WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  processTypeId String
  processType   ProcessType @relation(fields: [processTypeId], references: [id])
  order         Int
  quantityTotal Int
  instructions  String?

  // Dependencias
  requiresTaskId String?
  requires       WorkOrderTask?  @relation("TaskDependency", fields: [requiresTaskId], references: [id])
  requiredBy     WorkOrderTask[] @relation("TaskDependency")

  // Asignaciones
  assignedOperators WorkOrderTaskOperator[]

  // Estado global
  status TaskStatus @default(BLOCKED)

  // Registros de tiempo individuales
  timeRecords TaskTimeRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workOrderId, order])
  @@map("work_order_tasks")
}

model WorkOrderTaskOperator {
  id              String        @id @default(cuid())
  workOrderTaskId String
  workOrderTask   WorkOrderTask @relation(fields: [workOrderTaskId], references: [id], onDelete: Cascade)
  operatorId      String
  operator        Operator      @relation(fields: [operatorId], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([workOrderTaskId, operatorId])
  @@map("work_order_task_operators")
}

model TaskTimeRecord {
  id              String        @id @default(cuid())
  workOrderTaskId String
  workOrderTask   WorkOrderTask @relation(fields: [workOrderTaskId], references: [id], onDelete: Cascade)
  operatorId      String
  operator        Operator      @relation(fields: [operatorId], references: [id])

  status RecordStatus @default(NOT_STARTED)

  startedAt     DateTime?
  pausedAt      DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  totalPausedMs Int       @default(0)

  // Solo al pausar
  piecesAdvanced Int?
  pauseReason    String?

  // Piezas producidas al finalizar la tarea (opcional)
  // TODO: correr `npx prisma db push` y `npx prisma generate` después de este cambio
  piecesProduced Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderTaskId, operatorId])
  @@map("task_time_records")
}
